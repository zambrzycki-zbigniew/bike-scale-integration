{
  "name": "bike-scale-integration-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron:dev": "concurrently -k -s first \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.4.9",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "firebase": "^11.8.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vuetify": "^3.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^17.9.0",
    "vite": "^6.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.bikescale.dashboard",
    "productName": "Bike Dashboard",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
