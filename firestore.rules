rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy/duplicate metrics collection, read-only from the dashboard.
    match /bike-metrics/{docId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Bike ride sessions + their raw pulse samples.
    // Written by the bike's backend/ingest process (Admin SDK, bypasses these rules) —
    // the web dashboard only reads them.
    match /bike-sessions/{sessionId} {
      allow read:  if request.auth != null;
      allow write: if false;

      match /pulses/{pulseId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }

    // App-configurable parameters (e.g. pulsesPerKm), editable from the dashboard UI.
    match /parameters/bike-metrics {
      allow get: if request.auth != null;

      allow update: if request.auth != null
                    && request.resource.data
                         .diff(resource.data)
                         .affectedKeys().hasOnly(['pulsesPerKm'])
                    && request.resource.data.pulsesPerKm is number;

      allow create, delete: if false;
    }

    // Withings body-composition measurements. Written by get-body-metrics
    // (Admin SDK, bypasses these rules) — the web dashboard only reads them.
    match /body-metrics/{grpId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

